{% comment %}
  Example notification template: order confirmation.

  The whole file is pasted as the Admin "Email body (HTML)"; the Subject line
  below is parsed into the "Email subject" field. This comment header renders
  to nothing, so it is safe to keep in the body.

  Subject: Order {% raw %}{{ name }}{% endraw %} confirmed
{% endcomment %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Order confirmation</title>
</head>
<body style="margin:0; padding:0; background-color:#ffffff;">
  <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation">
    <tr>
      <td align="center" style="padding:40px 24px; font-family:Helvetica, Arial, sans-serif;">
        <h1 style="font-size:20px; margin:0 0 16px;">Thank you for your order, {{ customer.first_name }}!</h1>
        <p style="font-size:14px; margin:0 0 24px;">
          We received order {{ name }} and we're getting it ready.
        </p>
        <a href="{{ order_status_url }}" style="display:inline-block; padding:12px 24px; background:#111111; color:#ffffff; text-decoration:none; font-size:14px;">
          View your order
        </a>
      </td>
    </tr>
  </table>
</body>
</html>
